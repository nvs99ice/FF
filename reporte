<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reporte de Evidencia con Cámara y Páginas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                },
            },
        };
    </script>
    <style>
        /* Estilos generales */
        #signatureCanvas_reporte {
            border: 1px solid #d1d5db;
            border-radius: 0.375rem;
            background-color: white;
            cursor: crosshair;
            touch-action: none;
        }
        #signatureCanvasContainer_reporte {
            min-height: 150px;
        }
        .modal-overlay {
            z-index: 999;
        }
        .main-content {
            z-index: 10;
        }
        .camera-video {
            width: 100%;
            border-radius: 5px;
            display: none;
        }
        .camera-controls {
            display: flex;
            justify-content: center;
            padding-top: 10px;
        }
    </style>
</head>
<body class="bg-gray-100 flex flex-col items-center justify-start min-h-screen p-4 font-sans">
    <div id="loadingOverlay" class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-[998] hidden">
        <div class="bg-white p-6 rounded-lg shadow-xl flex items-center space-x-3">
            <svg class="animate-spin h-5 w-5 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-gray-700">Generando PDF...</p>
        </div>
    </div>

    <div id="confirmationModal_reporte" class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center modal-overlay hidden">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-sm">
            <h3 class="text-xl font-bold text-gray-800 mb-4 text-center">Confirmar</h3>
            <p class="text-gray-700 text-center mb-6">¿Estás seguro que quieres limpiar el formulario? Los datos actuales se perderán.</p>
            <div class="flex space-x-4">
                <button id="cancelClearButton_reporte" class="flex-1 justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Cancelar
                </button>
                <button id="confirmClearButton_reporte" class="flex-1 justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                    Confirmar
                </button>
            </div>
        </div>
    </div>
    <div id="clearSignatureConfirmationModal_reporte" class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center modal-overlay hidden">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-sm">
            <h3 class="text-xl font-bold text-gray-800 mb-4 text-center">Confirmar</h3>
            <p class="text-gray-700 text-center mb-6">¿Estás seguro que quieres borrar la firma?</p>
            <div class="flex space-x-4">
                <button id="cancelClearSignatureButton_reporte" class="flex-1 justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Cancelar
                </button>
                <button id="confirmClearSignatureButton_reporte" class="flex-1 justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                    Confirmar
                </button>
            </div>
        </div>
    </div>
    <div id="cameraModal" class="fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center modal-overlay hidden">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-xl">
            <h3 class="text-xl font-bold text-gray-800 mb-4 text-center">Tomar Foto para Evidencia</h3>
            <div class="relative">
                <video id="cameraVideo" class="camera-video" autoplay playsinline></video>
                <canvas id="cameraCanvas" class="hidden"></canvas>
            </div>
            <div id="cameraControls" class="camera-controls">
                <button type="button" id="takePhotoButton" class="bg-green-500 text-white font-medium py-2 px-4 rounded-full shadow-lg hover:bg-green-600 transition disabled:bg-gray-400">
                    Capturar
                </button>
            </div>
            <div class="flex justify-between mt-4">
                <button type="button" id="cancelCameraButton" class="py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                    Cancelar
                </button>
                <button type="button" id="confirmImageButton" class="py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400" disabled>
                    Usar Imagen
                </button>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-lg mb-6 main-content">
        <div class="flex justify-center mb-6">
            <img src="https://raw.githubusercontent.com/invs99/FF/refs/heads/SEGUNDA/freund1.png" alt="Logo Freund" class="h-16 w-auto" />
        </div>
        <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">Generador de Reporte de Evidencia</h1>
        <form id="documentForm_reporte" class="space-y-4">
            
            <div class="space-y-4 border p-4 rounded-md bg-gray-50">
                <h2 class="text-lg font-semibold text-gray-700 border-b pb-2">Información del Reporte</h2>
                <div>
                    <label for="nombre_reporte" class="block text-sm font-medium text-gray-700">Nombre del Reporte (Asunto)</label>
                    <input type="text" id="nombre_reporte" name="nombre_reporte" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2 border" required/>
                </div>
                <div>
                    <label for="nombre_tecnico" class="block text-sm font-medium text-gray-700">Nombre de quien Reporta</label>
                    <input type="text" id="nombre_tecnico" name="nombre_tecnico" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2 border" required/>
                </div>
            </div>

            <div class="space-y-4 border p-4 rounded-md bg-gray-50">
                <h2 class="text-lg font-semibold text-gray-700 border-b pb-2 flex justify-between items-center">
                    Detalle de Evidencia
                    <button type="button" id="addElementButton" class="bg-blue-500 text-white text-sm font-medium py-1 px-3 rounded-md hover:bg-blue-600 transition">
                        + Añadir Otra Página
                    </button>
                </h2>
                <div id="reportElementsContainer" class="space-y-6">
                    </div>
            </div>

            <div class="space-y-4 border p-4 rounded-md bg-gray-50">
                <h2 class="text-lg font-semibold text-gray-700 border-b pb-2">Firma del Reporteador</h2>
                <div class="mt-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Firma Digital</label>
                    <div id="signatureCanvasContainer_reporte" class="border rounded-md p-1 relative w-full h-auto">
                        <canvas id="signatureCanvas_reporte" class="w-full"></canvas>
                    </div>
                    <button type="button" id="clearSignatureButton_reporte" class="mt-2 w-1/2 mx-auto flex justify-center py-2 px-4 border border-green-300 rounded-md shadow-sm text-sm font-medium text-green-800 bg-green-200 hover:bg-green-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-400">
                        Borrar Firma
                    </button>
                </div>
            </div>
            
            <div class="flex flex-col space-y-2 mt-4">
                <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Generar Reporte PDF
                </button>
                <button type="button" id="clearFormButton_reporte" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                    Nuevo Reporte
                </button>
                <a href="index.html" class="w-full flex justify-center py-1.5 px-3 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-sky-500 hover:bg-sky-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-400 no-underline">
                    Inicio
                </a>
            </div>
        </form>
    </div>
    <div id="messageBox" class="fixed bottom-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 hidden">
        Documento generado con éxito.
    </div>

    <script>
        // --- DATA MANAGEMENT & DYNAMIC ELEMENTS ---
        let reportElements = []; // Stores objects: { id, description, image, details } // NEW: 'details' field added
        let elementCounter = 0;
        let currentElementIdForCamera = null;

        document.addEventListener('DOMContentLoaded', () => {
            loadFormData();
        });

        // --- CAMERA LOGIC ---
        const cameraModal = document.getElementById('cameraModal');
        const cameraVideo = document.getElementById('cameraVideo');
        const cameraCanvas = document.getElementById('cameraCanvas');
        const takePhotoButton = document.getElementById('takePhotoButton');
        const confirmImageButton = document.getElementById('confirmImageButton');
        const cancelCameraButton = document.getElementById('cancelCameraButton');
        let stream = null;
        let capturedImage = null;

        async function openCamera(elementId) {
            currentElementIdForCamera = elementId;
            capturedImage = null;
            confirmImageButton.disabled = true;
            cameraVideo.style.display = 'block';

            try {
                // Request access to the back camera (ideal for mobile)
                stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { facingMode: 'environment' }, 
                    audio: false 
                });
                cameraVideo.srcObject = stream;
                cameraVideo.play();
                cameraModal.classList.remove('hidden');
            } catch (err) {
                console.error("Error al acceder a la cámara:", err);
                alert("No se pudo acceder a la cámara. Asegúrate de tener permisos. Si estás en una PC, a veces la cámara no está disponible. Usa la opción 'Seleccionar Archivo'.");
                closeCameraModal();
            }
        }

        function closeCameraModal() {
            cameraModal.classList.add('hidden');
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
            }
            cameraVideo.pause();
            cameraVideo.srcObject = null;
            currentElementIdForCamera = null;
            capturedImage = null;
        }

        takePhotoButton.addEventListener('click', () => {
            if (!stream) return;

            const videoWidth = cameraVideo.videoWidth;
            const videoHeight = cameraVideo.videoHeight;

            cameraCanvas.width = videoWidth;
            cameraCanvas.height = videoHeight;
            const ctx = cameraCanvas.getContext('2d');
            
            // Draw the video frame to the canvas
            ctx.drawImage(cameraVideo, 0, 0, videoWidth, videoHeight);
            
            // Get the image data as Data URL
            capturedImage = cameraCanvas.toDataURL('image/jpeg', 0.8); // 80% quality
            
            // Display captured image and hide video feed temporarily
            cameraVideo.style.display = 'none';
            ctx.clearRect(0, 0, videoWidth, videoHeight);
            
            // Draw captured image back onto canvas for temporary display in modal
            const img = new Image();
            img.onload = function() {
                ctx.drawImage(img, 0, 0, cameraCanvas.width, cameraCanvas.height);
            };
            img.src = capturedImage;

            confirmImageButton.disabled = false;
        });

        cancelCameraButton.addEventListener('click', closeCameraModal);

        confirmImageButton.addEventListener('click', () => {
            if (capturedImage && currentElementIdForCamera) {
                const elementDiv = document.getElementById(currentElementIdForCamera);
                if (elementDiv) {
                    const element = reportElements.find(e => e.id === currentElementIdForCamera);
                    if (element) {
                        element.image = capturedImage;
                        
                        // Update the preview
                        const previewDiv = elementDiv.querySelector(`[data-preview-id="${currentElementIdForCamera}"]`);
                        previewDiv.classList.remove('hidden');
                        previewDiv.querySelector('img').src = capturedImage;
                        
                        const fileInput = elementDiv.querySelector('input[data-type="image"]');
                        if (fileInput) fileInput.value = '';

                        saveFormData();
                    }
                }
                closeCameraModal();
            }
        });


        // --- DYNAMIC ELEMENTS (FORM) ---
        function addReportElement(elementData = {}) {
            elementCounter++;
            const id = `el_${elementCounter}`;
            
            const container = document.getElementById('reportElementsContainer');
            const newElement = document.createElement('div');
            newElement.id = id;
            newElement.classList.add('p-3', 'border', 'rounded-md', 'bg-white', 'shadow-sm');
            
            newElement.innerHTML = `
                <div class="flex justify-between items-center mb-2 border-b pb-2">
                    <h3 class="font-medium text-gray-700">Página de Evidencia #${elementCounter}</h3>
                    <button type="button" onclick="removeReportElement('${id}')" class="text-red-500 hover:text-red-700 text-sm">
                        Eliminar
                    </button>
                </div>
                <div class="mb-3">
                    <label class="block text-sm font-medium text-gray-700">Sub-Tema o Breve Descripción</label>
                    <input type="text" data-type="description" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2 border" placeholder="Ej: Estado del Rack Principal" value="${elementData.description || ''}">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Foto (Opcional)</label>
                    <div class="flex space-x-2 mt-1">
                        <button type="button" data-action="capture" data-element-id="${id}" class="flex-1 flex items-center justify-center py-2 px-3 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-yellow-50 hover:bg-yellow-100 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2v-8a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A.5.5 0 0011 3H9a.5.5 0 00-.354.146L7.293 4.586a1 1 0 01-.707.293H4zm7 5a1 1 0 10-2 0 1 1 0 002 0zm-1 3a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
                            Tomar Foto
                        </button>
                        <input type="file" data-type="image" accept="image/*" class="flex-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100"/>
                    </div>
                    <div data-preview-id="${id}" class="mt-2 ${elementData.image ? '' : 'hidden'}">
                        <img src="${elementData.image || ''}" class="w-32 h-32 object-cover rounded-md border p-1" alt="Preview"/>
                    </div>
                </div>
                <div class="mt-3">
                    <label class="block text-sm font-medium text-gray-700">Detalles Adicionales de la Foto</label>
                    <textarea data-type="details" rows="2" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-2 border" placeholder="Observaciones, valores o comentarios específicos sobre la imagen subida.">${elementData.details || ''}</textarea>
                </div>
            `;
            
            container.appendChild(newElement);

            // Add new element to internal data structure
            const newElementObject = { 
                id: id, 
                description: elementData.description || '', 
                image: elementData.image || '',
                details: elementData.details || '' // NEW: details field added
            };
            reportElements.push(newElementObject);

            // Add event listeners for the new element's inputs
            const descInput = newElement.querySelector('input[data-type="description"]');
            const detailsInput = newElement.querySelector('textarea[data-type="details"]'); // NEW: listener for details
            const imageInput = newElement.querySelector('input[data-type="image"]');
            const captureButton = newElement.querySelector('button[data-action="capture"]');
            
            // Listener para el botón de cámara
            captureButton.addEventListener('click', (event) => {
                const elementId = event.currentTarget.getAttribute('data-element-id');
                openCamera(elementId);
            });

            descInput.addEventListener('input', () => {
                const element = reportElements.find(e => e.id === id);
                if (element) {
                    element.description = descInput.value;
                    saveFormData();
                }
            });

            // NEW: Listener for Details
            detailsInput.addEventListener('input', () => {
                const element = reportElements.find(e => e.id === id);
                if (element) {
                    element.details = detailsInput.value;
                    saveFormData();
                }
            });

            imageInput.addEventListener('change', (event) => {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const element = reportElements.find(e => e.id === id);
                        if (element) {
                            element.image = e.target.result;
                            const previewDiv = newElement.querySelector(`[data-preview-id="${id}"]`);
                            previewDiv.classList.remove('hidden');
                            previewDiv.querySelector('img').src = e.target.result;
                            saveFormData();
                        }
                    };
                    reader.readAsDataURL(file);
                } else {
                    const element = reportElements.find(e => e.id === id);
                    if (element) {
                        element.image = '';
                        const previewDiv = newElement.querySelector(`[data-preview-id="${id}"]`);
                        previewDiv.classList.add('hidden');
                        previewDiv.querySelector('img').src = '';
                        saveFormData();
                    }
                }
            });

            saveFormData();
        }

        function removeReportElement(id) {
            document.getElementById(id).remove();
            reportElements = reportElements.filter(e => e.id !== id);
            
            // Re-render to update element numbers (Page #) and save data
            const savedReportElements = [...reportElements];
            reportElements = [];
            elementCounter = 0;
            document.getElementById('reportElementsContainer').innerHTML = '';
            savedReportElements.forEach(el => addReportElement(el));
            
            // If all elements were removed, add a blank one back
            if (reportElements.length === 0) {
                addReportElement();
            }
            saveFormData();
        }

        document.getElementById('addElementButton').addEventListener('click', () => addReportElement());

        // --- COMMON FUNCTIONS ---
        function showMessage(message, type = 'success') {
            const messageBox = document.getElementById('messageBox');
            messageBox.textContent = message;
            if (type === 'success') {
                messageBox.className = 'fixed bottom-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50';
            } else if (type === 'error') {
                messageBox.className = 'fixed bottom-4 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50';
            }
            messageBox.classList.remove('hidden');
            setTimeout(() => {
                messageBox.classList.add('hidden');
            }, 3000);
        }

        // --- SIGNATURE CANVAS LOGIC ---
        const canvas = document.getElementById('signatureCanvas_reporte');
        const ctx = canvas.getContext('2d');
        let isDrawing = false;
        let lastX = 0;
        let lastY = 0;
        let hasSigned = false;

        function drawPlaceholder() {
            if (!hasSigned) {
                ctx.save();
                ctx.fillStyle = '#E5E7EB';
                ctx.font = '24px Inter, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                const x = canvas.width / 2;
                const y = canvas.height / 2;
                ctx.fillText('Firma del Reporteador', x, y);
                ctx.restore();
            }
        }

        function resizeCanvas() {
            const container = document.getElementById('signatureCanvasContainer_reporte');
            const newWidth = container.offsetWidth;
            const newHeight = container.offsetHeight;
            canvas.width = newWidth;
            canvas.height = newHeight;
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, newWidth, newHeight);
            
            const savedData = localStorage.getItem('documentFormData_reporte_simple');
            if (savedData) {
                const data = JSON.parse(savedData);
                if (data.signature) {
                    hasSigned = true;
                    const img = new Image();
                    img.onload = function() {
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    };
                    img.src = data.signature;
                    return;
                }
            }
            hasSigned = false;
            drawPlaceholder();
        }

        document.addEventListener('DOMContentLoaded', resizeCanvas);
        window.addEventListener('resize', resizeCanvas);

        function draw(e) {
            if (!isDrawing) return;
            if (!hasSigned) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = 'white';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                hasSigned = true;
            }
            const rect = canvas.getBoundingClientRect();
            const x = (e.clientX || e.touches[0].clientX) - rect.left;
            const y = (e.clientY || e.touches[0].clientY) - rect.top;
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(x, y);
            ctx.strokeStyle = '#000';
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.stroke();
            [lastX, lastY] = [x, y];
        }

        canvas.addEventListener('mousedown', (e) => {
            isDrawing = true;
            const rect = canvas.getBoundingClientRect();
            [lastX, lastY] = [e.clientX - rect.left, e.clientY - rect.top];
        });
        canvas.addEventListener('touchstart', (e) => {
            isDrawing = true;
            const rect = canvas.getBoundingClientRect();
            [lastX, lastY] = [e.touches[0].clientX - rect.left, e.touches[0].clientY - rect.top];
            e.preventDefault();
        });
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('touchmove', draw);
        canvas.addEventListener('mouseup', () => isDrawing = false);
        canvas.addEventListener('touchend', () => isDrawing = false);
        canvas.addEventListener('mouseout', () => isDrawing = false);

        // --- FORM AND STORAGE LOGIC ---
        const form = document.getElementById('documentForm_reporte');

        function saveFormData() {
            const formData = new FormData(form);
            const data = {};
            for (const [key, value] of formData.entries()) {
                data[key] = value;
            }
            if (hasSigned) {
                data.signature = canvas.toDataURL('image/png');
            } else {
                data.signature = null;
            }
            
            data.reportElements = reportElements;

            localStorage.setItem('documentFormData_reporte_simple', JSON.stringify(data));
        }

        function loadFormData() {
            const savedData = localStorage.getItem('documentFormData_reporte_simple');
            if (savedData) {
                const data = JSON.parse(savedData);
                for (const key in data) {
                    const input = document.getElementById(key);
                    if (input) {
                        input.value = data[key];
                    }
                }
                
                if (data.reportElements && Array.isArray(data.reportElements)) {
                    reportElements = [];
                    elementCounter = 0;
                    document.getElementById('reportElementsContainer').innerHTML = '';
                    data.reportElements.forEach(el => addReportElement(el));
                }

                if (data.signature) {
                    hasSigned = true;
                    const img = new Image();
                    img.onload = function() {
                        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    };
                    img.src = data.signature;
                } else {
                    hasSigned = false;
                    drawPlaceholder();
                }
            } else {
                hasSigned = false;
                drawPlaceholder();
                if (reportElements.length === 0) {
                    addReportElement();
                }
            }
        }
        
        form.addEventListener('input', saveFormData);
        window.addEventListener('load', loadFormData);

        // --- PDF GENERATION LOGIC ---
        document.getElementById('documentForm_reporte').addEventListener('submit', async function(e) {
            e.preventDefault();
            const loadingOverlay = document.getElementById('loadingOverlay');
            loadingOverlay.style.display = 'flex';

            try {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();
                const formData = new FormData(e.target);
                const data = Object.fromEntries(formData.entries());
                
                const reportElementsData = reportElements.filter(el => el.description || el.image || el.details); // Filter elements that have content
                const totalElements = reportElementsData.length;
                let y = 15;
                const margin = 15;
                const pageWidth = doc.internal.pageSize.getWidth();
                const logoHeight = 17;
                const logoWidth = 34;
                const logoUrl = 'https://raw.githubusercontent.com/invs99/FF/refs/heads/SEGUNDA/freund1.png';
                const reportDate = new Date().toLocaleDateString();

                // Function to add Header and Footer
                async function addHeader(doc, y, pageNum, totalPages) {
                    const headerY = 15;
                    const headerX = pageWidth - margin;

                    let base64Image = '';
                    try {
                        const response = await fetch(logoUrl);
                        if (!response.ok) throw new Error('Failed to fetch logo');
                        const blob = await response.blob();
                        const reader = new FileReader();
                        reader.readAsDataURL(blob);
                        base64Image = await new Promise((resolve, reject) => {
                            reader.onloadend = () => resolve(reader.result);
                            reader.onerror = reject;
                        });
                        doc.addImage(base64Image, 'PNG', margin, headerY, logoWidth, logoHeight);
                    } catch (error) {
                        console.warn('No se pudo cargar el logo para el PDF:', error);
                    }

                    doc.setFontSize(8);
                    doc.setFont('helvetica', 'normal');
                    doc.text('Tiendas 01.001.0001.0001', headerX, headerY, null, null, 'right');
                    doc.text('Redes y Soporte', headerX, headerY + 4, null, null, 'right');
                    doc.text('Telecomunicaciones', headerX, headerY + 8, null, null, 'right');
                    doc.text(`Fecha de Reporte: ${reportDate}`, headerX, headerY + 12, null, null, 'right');
                    
                    const titleY = headerY + (Math.max(logoHeight, 15) / 2) + 2;
                    doc.setFontSize(16);
                    doc.setFont('helvetica', 'bold');
                    doc.text(data.nombre_reporte.toUpperCase() || 'REPORTE DE EVIDENCIA', pageWidth / 2, titleY, { align: 'center' });

                    y = headerY + Math.max(logoHeight, 15) + 10;
                    doc.line(margin, y, pageWidth - margin, y);
                    y += 8;
                    
                    doc.setFontSize(10);
                    doc.setFont('helvetica', 'normal');
                    const finalTotalPages = 1 + totalElements;
                    doc.text(`Página ${pageNum} de ${finalTotalPages}`, pageWidth - margin, y - 2, null, null, 'right');

                    return y;
                }

                // --- Page 1: Information and Signature ---
                let totalPages = totalElements > 0 ? totalElements + 1 : 1; 
                let pageNum = 1;
                y = await addHeader(doc, y, pageNum, totalPages);
                
                doc.setFontSize(12);
                doc.setFont('helvetica', 'bold');
                doc.text('I. INFORMACIÓN Y RESUMEN', margin, y);
                y += 6;
                doc.setFont('helvetica', 'normal');
                doc.text(`Reporte generado por: ${data.nombre_tecnico}`, margin, y);
                doc.text(`Fecha de Generación: ${reportDate}`, pageWidth / 2, y);
                y += 10;
                doc.text(`Asunto del Reporte: ${data.nombre_reporte}`, margin, y);
                y += 15;

                // --- Signature ---
                doc.setFont('helvetica', 'bold');
                doc.text('FIRMA DEL REPORTEADOR', margin, y);
                y += 5;
                
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(12);
                
                const signatureData = canvas.toDataURL('image/png');
                const signatureImageHeight = 20; 

                if (hasSigned) {
                    const signatureWidth = 60;
                    const signatureImageY = y;
                    doc.addImage(signatureData, 'PNG', margin + 10, signatureImageY, signatureWidth, signatureImageHeight);
                    y += signatureImageHeight + 2; 
                } else {
                    y += signatureImageHeight + 2;
                }

                const tecnicoName = data.nombre_tecnico;
                const tecnicoLabel = "Nombre: ";
                const tecnicoText = tecnicoLabel + tecnicoName;
                const tecnicoTextWidth = doc.getStringUnitWidth(tecnicoText) * doc.internal.getFontSize();
                
                doc.line(margin, y, margin + (tecnicoTextWidth * 0.4), y);
                y += 5; 
                doc.text(tecnicoText, margin, y);
                y += 10;


                // --- Pages 2 to N: Elements (Each on a new page) ---
                for (let i = 0; i < totalElements; i++) {
                    const element = reportElementsData[i];
                    
                    doc.addPage();
                    pageNum++;
                    y = await addHeader(doc, margin, pageNum, totalPages);

                    // Sub-Tema/Descripción como Título de la Evidencia
                    doc.setFont('helvetica', 'bold');
                    doc.text(`II. EVIDENCIA - ${element.description || 'SIN SUB-TEMA'}`, margin, y);
                    y += 8;

                    doc.setFontSize(11);
                    doc.setFont('helvetica', 'normal');
                    doc.text(`Página de Detalle #${i + 1}`, margin, y);
                    y += 5;

                    // Image
                    if (element.image) {
                        const img = new Image();
                        await new Promise(resolve => {
                            img.onload = resolve;
                            img.src = element.image;
                        });

                        const maxImgWidth = pageWidth - (margin * 2);
                        // Make room for the details text at the bottom
                        const textLines = doc.splitTextToSize(element.details || 'Sin detalles.', maxImgWidth);
                        const textHeight = textLines.length * 5; // Approx height for text (5 units per line)

                        const maxImgHeight = doc.internal.pageSize.getHeight() - y - margin - textHeight - 10; // 10 units buffer
                        
                        let imgWidth = img.width;
                        let imgHeight = img.height;

                        if (imgWidth > maxImgWidth) {
                            imgHeight = (imgHeight * maxImgWidth) / imgWidth;
                            imgWidth = maxImgWidth;
                        }
                        if (imgHeight > maxImgHeight) {
                            imgWidth = (imgWidth * maxImgHeight) / imgHeight;
                            imgHeight = maxImgHeight;
                        }
                        
                        doc.addImage(element.image, 'JPEG', margin, y, imgWidth, imgHeight);
                        y += imgHeight + 5; 
                    } else {
                        doc.text('No se adjuntó imagen para este elemento.', margin, y);
                        y += 10;
                    }

                    // NEW: Details Text
                    doc.setFontSize(10);
                    doc.setFont('helvetica', 'bold');
                    doc.text('Detalles Adicionales:', margin, y);
                    y += 4;
                    doc.setFont('helvetica', 'normal');
                    const detailsLines = doc.splitTextToSize(element.details || 'Sin detalles.', pageWidth - (margin * 2));
                    doc.text(detailsLines, margin, y);
                    y += (detailsLines.length * 5) + 5; // 5 units per line + buffer

                    y += 5; // Separator
                }


                // 7. Finalizar
                const fileName = data.nombre_reporte.replace(/[^a-z0-9]/gi, '_').substring(0, 30);
                doc.save(`${fileName}_${new Date().getTime()}.pdf`);
                
                loadingOverlay.style.display = 'none';
                showMessage('Reporte generado con éxito.', 'success');

            } catch (error) {
                console.error('Error al generar el PDF:', error);
                loadingOverlay.style.display = 'none';
                showMessage('Error al generar el documento.', 'error');
            }
        });

        // --- CLEAR FORM AND SIGNATURE LOGIC ---
        document.getElementById('clearFormButton_reporte').addEventListener('click', function() {
            document.getElementById('confirmationModal_reporte').classList.remove('hidden');
        });

        document.getElementById('cancelClearButton_reporte').addEventListener('click', function() {
            document.getElementById('confirmationModal_reporte').classList.add('hidden');
        });

        document.getElementById('confirmClearButton_reporte').addEventListener('click', function() {
            document.getElementById('documentForm_reporte').reset();
            
            reportElements = [];
            elementCounter = 0;
            document.getElementById('reportElementsContainer').innerHTML = '';
            addReportElement();

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            hasSigned = false;
            drawPlaceholder();
            
            document.getElementById('confirmationModal_reporte').classList.add('hidden');
            showMessage('Formulario limpiado. Listo para un nuevo reporte.', 'success');
            localStorage.removeItem('documentFormData_reporte_simple');
        });

        document.getElementById('clearSignatureButton_reporte').addEventListener('click', function() {
            document.getElementById('clearSignatureConfirmationModal_reporte').classList.remove('hidden');
        });

        document.getElementById('cancelClearSignatureButton_reporte').addEventListener('click', function() {
            document.getElementById('clearSignatureConfirmationModal_reporte').classList.add('hidden');
        });

        document.getElementById('confirmClearSignatureButton_reporte').addEventListener('click', function() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = 'white';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            hasSigned = false;
            drawPlaceholder();
            saveFormData();
            document.getElementById('clearSignatureConfirmationModal_reporte').classList.add('hidden');
            showMessage('Firma borrada.', 'success');
        });
        
        if (reportElements.length === 0) {
            addReportElement();
        }
    </script>
</body>
</html>
